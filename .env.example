# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Two providers, two keys (python run.py --api-key <GEMINI_KEY> reads the Apify token from here).

# Discover: Apify token for the clockworks/tiktok-scraper actor, which fetches each trend's
# example video(s) by exact URL. Get one at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Gemini key, used by every stage: Discover's trend pre-filter, Process's video analysis and
# scoring, and Generate's scripts, reference-image description and Veo video generation.
# Get one at https://aistudio.google.com/apikey (Veo needs a billing-enabled/paid key).
GEMINI_API_KEY=
